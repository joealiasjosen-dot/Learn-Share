DATABASE_URL=postgres://user:pass@localhost:5432/learnshare
JWT_SECRET=change-me-long-random
# Each user adds their own Anthropic key in Settings. Keys are stored encrypted with KEY_ENC.
KEY_ENC=generate-with-openssl-rand-hex-32
# Optional: let users without a key use this key (you pay). Leave 0 for bring-your-own-key only.
ALLOW_SERVER_KEY=0
#ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5
SMTP_URL=smtps://user:pass@smtp.yourdomain.com
MAIL_FROM="Learn&Share <no-reply@yourdomain.com>"
TRANSCRIBE_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIBE_KEY=
PORT=8080
